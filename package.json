{
  "name": "alevel-study-coach",
  "version": "0.1.7",
  "description": "A-Level Study Coach - on-demand study coach & weakness finder for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/index.ts --bundle --platform=node --format=cjs --alias:obsidian=./test/obsidian-stub.ts --outfile=test/run.js --log-level=warning && node test/run.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "a-level",
    "ielts",
    "study-coach"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "obsidian": "1.5.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  }
}
